-  { id: "ROUTE-88", categorieId: "route_general", titre: "Absence de plaque", contenu: "La circulation sans plaque d'immatriculation constitue une infraction." },
-  { id: "ROUTE-89", categorieId: "route_general", titre: "Plaque illisible", contenu: "Il est interdit de circuler avec une plaque volontairement ou involontairement rendue illisible." },
-  { id: "ROUTE-90", categorieId: "route_general", titre: "Plaque falsifiee", contenu: "Toute modification volontaire d'une plaque d'immatriculation est interdite." },
-  { id: "ROUTE-91", categorieId: "route_general", titre: "Modifications autorisees", contenu: "Les modifications demeurent autorisees des lors qu'elles ne compromettent pas la sécurité ou l'identification du véhicule." },
-  { id: "ROUTE-92", categorieId: "route_general", titre: "Modifications interdites", contenu: "Sont interdites les modifications ayant pour effet d'augmenter dangereusement les performances, de supprimer un équipement de sécurité, d'empêcher l'identification du véhicule." },
