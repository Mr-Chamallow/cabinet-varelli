-  { id: "ROUTE-125", categorieId: "route_general", titre: "Motocyclettes", contenu: "Les motocyclistes sont soumis aux memes regles de circulation que les autres conducteurs, sous réserve de dispositions particulières." },
-  { id: "ROUTE-126", categorieId: "route_general", titre: "Interfile", contenu: "La circulation entre les files de vehicules est autorisee uniquement lorsqu'elle est expressément prévue par la réglementation." },
-  { id: "ROUTE-127", categorieId: "route_general", titre: "Protection", contenu: "Les conducteurs doivent veiller à ne pas compromettre la sécurité des usagers circulant sur deux roues." },
-  { id: "ROUTE-128", categorieId: "route_general", titre: "Conduite agressive", contenu: "Toute conduite agressive est interdite." },
-  { id: "ROUTE-129", categorieId: "route_general", titre: "Courses illegales", contenu: "L'organisation ou la participation à une course non autorisée sur la voie publique est interdite." },
-  { id: "ROUTE-130", categorieId: "route_general", titre: "Rodeo urbain", contenu: "Le fait d'effectuer volontairement des mancuvres dangereuses ou spectaculaires constitue un rodéo urbain dès lors que les participants sont au minimum 5. Cette infraction est punie d'une amende de 500$.", amende: "500$" },
-  { id: "ROUTE-131", categorieId: "route_general", titre: "Drift", contenu: "La réalisation volontaire de dérapages contrôlés sur la voie publique est interdite. Cette infraction est punie d'une amende de 250$.", amende: "250$" },
-  { id: "ROUTE-132", categorieId: "route_general", titre: "Zigzag", contenu: "Le fait de changer de voie de maniere repetee et dangereuse constitue une conduite dangereuse. Cette infraction est punie d'une amende de 250$.", amende: "250$" },
-  { id: "ROUTE-133", categorieId: "route_general", titre: "Intimidation", contenu: "Il est interdit d'utiliser son véhicule pour intimider un autre usager." },
-  { id: "ROUTE-134", categorieId: "route_general", titre: "Obstruction volontaire", contenu: "Nul ne peut volontairement bloquer ou ralentir la circulation sans motif légitime. Cette infraction est punie d'une amende de 500$.", amende: "500$" },
-  { id: "ROUTE-135", categorieId: "route_general", titre: "Utilisation du vehicule comme arme", contenu: "L'utilisation intentionnelle d'un véhicule pour heurter une personne ou un autre véhicule est régie par les dispositions du Code pénal." },
-  { id: "ROUTE-136", categorieId: "route_general", titre: "Principe general", contenu: "Tout comportement non expressément prévu par le présent Livre mais créant un danger manifeste pour la sécurité routière peut être sanctionné conformément au présent Code et, le cas échéant, au Code pénal." },
-  { id: "ROUTE-137", categorieId: "route_general", titre: "Principe de prudence", contenu: "Tout conducteur abordant une intersection doit reduire sa vitesse et demeurer en mesure de ceder le passage conformément aux règles du présent Code." },
-  { id: "ROUTE-138", categorieId: "route_general", titre: "Priorite de securite", contenu: "Aucune priorité ne dispense un conducteur de son obligation d'éviter un accident lorsqu'il peut raisonnablement le faire." },
-  { id: "ROUTE-139", categorieId: "route_general", titre: "Respect de la signalisation", contenu: "Les règles de priorité résultant de la signalisation routière prévalent sur les règles générales." },
-  { id: "ROUTE-140", categorieId: "route_general", titre: "Ordres des agents", contenu: "Les injonctions donnees par un agent habilite priment sur les panneaux, les feux de signalisation et toute autre règle de circulation." },
-  { id: "ROUTE-141", categorieId: "route_general", titre: "Responsabilite", contenu: "Le conducteur qui beneficie d'une priorite demeure responsable de toute manœuvre imprudente ou dangereuse." },
-  { id: "ROUTE-142", categorieId: "route_general", titre: "Priorite", contenu: "Le conducteur doit ceder le passage aux pietons engages ou manifestant clairement leur intention de traverser." },
-  { id: "ROUTE-143", categorieId: "route_general", titre: "Vigilance", contenu: "Une vigilance renforcée est exigée à proximité des passages piétons." },
-  { id: "ROUTE-144", categorieId: "route_general", titre: "Depassement", contenu: "Il est interdit de dépasser un véhicule arrêté afin de laisser traverser un piéton." },
-  { id: "ROUTE-145", categorieId: "route_general", titre: "Obstruction", contenu: "Il est interdit d'immobiliser un véhicule sur un passage piéton." },
-  { id: "ROUTE-146", categorieId: "route_general", titre: "Personnes vulnerables", contenu: "Les enfants, personnes agées ou personnes en situation de handicap bénéficient d'une protection particulière." },
-  { id: "ROUTE-147", categorieId: "route_general", titre: "Vehicules concernes", contenu: "Sont prioritaires les vehicules de police, des services d'incendie, des services medicaux d'urgence ainsi que tout véhicule bénéficiant légalement d'une priorité." },
-  { id: "ROUTE-148", categorieId: "route_general", titre: "Obligation des usagers", contenu: "Tout conducteur doit immediatement faciliter le passage d'un véhicule prioritaire utilisant ses avertisseurs sonores et lumineux." },
-  { id: "ROUTE-149", categorieId: "route_general", titre: "Move Over Law", contenu: "Lorsqu'un véhicule prioritaire ou d'assistance est immobilise sur le bord de la chaussée avec ses dispositifs lumineux activés, tout conducteur doit changer de voie lorsqu'il est possible de le faire en sécurité, ou à défaut ralentir significativement afin de protéger les intervenants." },
-  { id: "ROUTE-150", categorieId: "route_general", titre: "Corteges officiels", contenu: "Les cortèges officiels bénéficiant d'une escorte policière ou gouvernementale sont prioritaires." },
