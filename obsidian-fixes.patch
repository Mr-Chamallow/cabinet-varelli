+  { id: "ROUTE-47", categorieId: "route_permis", titre: "Aptitude mentale", contenu: "Le conducteur doit être en pleine possession de ses facultés." },
+  { id: "ROUTE-48", categorieId: "route_permis", titre: "Fatigue", contenu: "Il est interdit de conduire lorsqu'un état de fatigue compromet la sécurité." },
