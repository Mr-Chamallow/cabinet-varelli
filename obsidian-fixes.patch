-  { id: "ROUTE-152", categorieId: "route_general", titre: "Obstruction volontaire", contenu: "Il est interdit de bloquer volontairement une intersection. Cette infraction est punie d'une amende de 350$.", amende: "350$" },
-  { id: "ROUTE-153", categorieId: "route_general", titre: "Respect mutuel", contenu: "Les usagers doivent adopter un comportement permettant une circulation fluide et sécurisée." },
-  { id: "ROUTE-154", categorieId: "route_general", titre: "Pouvoir des autorites", contenu: "Les forces de l'ordre peuvent reglementer temporairement les priorites lors d'accidents, de manifestations, de travaux ou de toute situation exceptionnelle." },
-  { id: "ROUTE-155", categorieId: "route_general", titre: "Principe general", contenu: "Toute règle de priorité prévue par le présent Livre doit être interprétée à la lumière du principe fondamental de sécurité routière. Aucun usager ne peut invoquer sa priorité pour justifier un comportement dangereux." },
-  { id: "ROUTE-156", categorieId: "route_general", titre: "Principe du controle routier", contenu: "Les forces de l'ordre peuvent proceder au controle d'un vehicule circulant sur la voie publique dans les conditions prévues par le présent Code. Tout contrôle doit être effectué dans le respect de la loi, des droits du conducteur et du principe de proportionnalité." },
-  { id: "ROUTE-157", categorieId: "route_general", titre: "Controle sans infraction prealable", contenu: "Un véhicule peut faire l'objet d'un controle routier sans que le conducteur ait prealablement commis une infraction lorsqu'un controle legalement autorise est mis en place. Un contrôle ne peut toutefois être fondé sur un motif discriminatoire, arbitraire ou étranger à l'application de la loi." },
-  { id: "ROUTE-158", categorieId: "route_general", titre: "Controle consecutif a une infraction", contenu: "Lorsqu'un agent constate une infraction au Code de la route, il peut proceder a l'interception du véhicule afin de vérifier l'identité du conducteur, son permis de conduire et les circonstances de l'infraction." },
-  { id: "ROUTE-159", categorieId: "route_general", titre: "Controle du permis", contenu: "Le conducteur doit être en mesure de presenter son permis de conduire lorsqu'un agent légalement habilité le lui demande." },
-  { id: "ROUTE-160", categorieId: "route_general", titre: "Controle des documents", contenu: "L'agent peut demander la présentation des documents nécessaires à la conduite et à la circulation du véhicule, notamment permis de conduire, carte d'identité, contrôle des clés." },
-  { id: "ROUTE-161", categorieId: "route_general", titre: "Contrôle du véhicule", contenu: "Un contrôle visuel du véhicule peut être effectué afin de vérifier son état général, sa conformité aux règles de circulation et la présence éventuelle d'éléments présentant un danger manifeste. Toute fouille approfondie du véhicule doit répondre aux conditions prévues par le Code de procédure pénale." },
-  { id: "ROUTE-162", categorieId: "route_general", titre: "Controle d'alcoolemie", contenu: "Lorsqu'un controle d'alcoolemie est legalement autorise, le conducteur est tenu de se soumettre aux vérifications prévues par la loi." },
-  { id: "ROUTE-163", categorieId: "route_general", titre: "Dépistage de stupéfiants", contenu: "Les forces de l'ordre peuvent proceder a un depistage de stupefiants lorsque les conditions prévues par la loi sont réunies." },
-  { id: "ROUTE-164", categorieId: "route_general", titre: "Fin du controle", contenu: "Une fois les vérifications terminées, l'agent doit permettre au conducteur de reprendre sa route lorsque rien ne justifie légalement son maintien ou l'immobilisation du véhicule." },
-  { id: "ROUTE-165", categorieId: "route_general", titre: "Conditions d'immobilisation", contenu: "Un véhicule peut être immobilisé lorsque son état présente un danger pour la circulation, le conducteur n'est pas légalement autorisé à conduire, le véhicule est utilisé pour commettre une infraction, une disposition légale impose son immobilisation." },
-  { id: "ROUTE-166", categorieId: "route_general", titre: "Mise en fourriere", contenu: "Un véhicule peut être placé en fourrière dans les conditions prévues par la loi. La décision doit être justifiée par un motif légal." },
-  { id: "ROUTE-167", categorieId: "route_general", titre: "Principe", contenu: "Le permis de conduire ne peut etre retire, suspendu ou annule que dans les conditions prevue par la loi. Une simple infraction routière n'entraîne pas automatiquement le retrait du permis lorsque le présent Code ne le prévoit pas." },
-  { id: "ROUTE-168", categorieId: "route_general", titre: "Suspension administrative", contenu: "La suspension du permis peut être prononcée lorsque le conducteur présente un danger suffisamment caractérisé pour la sécurité publique ou lorsqu'une infraction prévue par le présent Code justifie cette mesure. La durée de la suspension doit être proportionnée à la gravité des faits." },
-  { id: "ROUTE-169", categorieId: "route_general", titre: "Suspension judiciaire", contenu: "Le Juge peut prononcer la suspension du permis lorsqu'une infraction commise par le conducteur le justifie. La décision judiciaire précise la durée de la suspension, les motifs, les éventuelles conditions de restitution." },
-  { id: "ROUTE-170", categorieId: "route_general", titre: "Retrait du permis", contenu: "Le retrait definitif ou l'annulation du permis constitue une mesure exceptionnelle reservee aux situations prévues par la loi ou à une décision judiciaire." },
-  { id: "ROUTE-171", categorieId: "route_general", titre: "Motifs pouvant justifier un retrait", contenu: "Peuvent notamment justifier un retrait: conduite répétée sous influence, conduite dangereuse grave, récidive importante, accumulation d'infractions entraînant la perte du droit de conduire (3 au minimum), utilisation du véhicule pour commettre une infraction grave, conduite malgré une suspension, obtention frauduleuse du permis." },
-  { id: "ROUTE-172", categorieId: "route_general", titre: "Interdiction de conduire", contenu: "Lorsqu'un permis est suspendu, annule ou retire, la personne concernee ne peut conduire aucun véhicule nécessitant un permis pendant la durée de la mesure." },
-  { id: "ROUTE-173", categorieId: "route_general", titre: "Notification", contenu: "Toute suspension, rétention ou annulation doit être portée à la connaissance du conducteur. La notification indique le motif, la durée, l'autorité ayant pris la décision, les conséquences, les voies de recours applicables." },
-  { id: "ROUTE-174", categorieId: "route_general", titre: "Droit au recours", contenu: "Toute personne faisant l'objet d'une suspension ou d'un retrait dispose d'un droit de contestation devant l'autorité compétente dans les conditions prévues par la loi." },
-  { id: "ROUTE-175", categorieId: "route_general", titre: "Interdiction de retrait arbitraire", contenu: "Aucun agent ne peut retirer ou suspendre définitivement un permis de sa propre initiative lorsqu'une decision du Procureur ou du Juge est legalement requise." },
+  { id: "ROUTE-36", categorieId: "route_permis", titre: "Obligation de detenir un permis", contenu: "Nul ne peut conduire un véhicule motorisé sur une voie publique sans être titulaire d'un permis de conduire valide correspondant à la catégorie du véhicule utilisé." },
+  { id: "ROUTE-37", categorieId: "route_permis", titre: "Validite du permis", contenu: "Le permis de conduire doit être valide, être délivré par une autorité compétente, ne faire l'objet d'aucune suspension ou annulation." },
+  { id: "ROUTE-38", categorieId: "route_permis", titre: "Presentation du permis", contenu: "Tout conducteur doit être en mesure de presenter son permis lors d'un contrôle routier. L'absence de présentation peut entraîner une vérification d'identité ainsi que les sanctions prévues par la loi." },
