-  { id: "ROUTE-61", categorieId: "route_general", titre: "Restitution", contenu: "La restitution du permis intervient conformément à la décision de l'autorité compétente." },
-  { id: "ROUTE-62", categorieId: "route_general", titre: "Conduite sans permis", contenu: "Le fait de conduire sans être titulaire du permis requis constitue une infraction." },
-  { id: "ROUTE-63", categorieId: "route_general", titre: "Conduite malgre suspension", contenu: "Le fait de conduire malgré une suspension constitue un délit routier." },
-  { id: "ROUTE-64", categorieId: "route_general", titre: "Conduite malgre annulation", contenu: "Le fait de conduire malgré une annulation du permis constitue un délit routier aggravé." },
-  { id: "ROUTE-65", categorieId: "route_general", titre: "Faux permis", contenu: "L'usage d'un faux permis constitue un délit et peut donner lieu à des poursuites pénales." },
-  { id: "ROUTE-66", categorieId: "route_general", titre: "Obtention frauduleuse", contenu: "Toute obtention frauduleuse d'un permis est interdite." },
-  { id: "ROUTE-67", categorieId: "route_general", titre: "Usurpation", contenu: "L'utilisation du permis appartenant à un tiers constitue une usurpation d'identité." },
-  { id: "ROUTE-68", categorieId: "route_general", titre: "Conducteurs commerciaux", contenu: "Les conducteurs exercant une activite professionnelle sont soumis aux obligations du present Code." },
-  { id: "ROUTE-69", categorieId: "route_general", titre: "Transport de passagers", contenu: "Les conducteurs transportant des passagers à titre professionnel sont tenus à une obligation renforcée de prudence." },
-  { id: "ROUTE-70", categorieId: "route_general", titre: "Transport de marchandises", contenu: "Le conducteur est responsable de l'arrimage et de la sécurité du chargement." },
-  { id: "ROUTE-71", categorieId: "route_general", titre: "Matieres dangereuses", contenu: "Le transport de matières dangereuses est soumis à des réglementations particulières." },
-  { id: "ROUTE-72", categorieId: "route_general", titre: "Vehicules prioritaires", contenu: "Les conducteurs des véhicules prioritaires bénéficient des dérogations prévues par la loi lorsqu'ils sont en intervention." },
-  { id: "ROUTE-73", categorieId: "route_general", titre: "Conditions d'utilisation", contenu: "Les avertisseurs sonores et lumineux ne peuvent être utilisés qu'en cas de nécessité." },
