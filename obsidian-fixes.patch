-  { id: "ROUTE-75", categorieId: "route_general", titre: "Responsabilite", contenu: "L'usage abusif des privileges accordes aux véhicules prioritaires engage la responsabilité de leur conducteur." },
-  { id: "ROUTE-76", categorieId: "route_general", titre: "Respect des contrôles", contenu: "Tout conducteur doit se soumettre aux contrôles légalement ordonnés." },
-  { id: "ROUTE-77", categorieId: "route_general", titre: "Cooperation", contenu: "Le conducteur doit répondre aux injonctions des agents habilités." },
-  { id: "ROUTE-78", categorieId: "route_general", titre: "Identification", contenu: "Le conducteur doit décliner son identité lorsqu'il en est légalement requis." },
-  { id: "ROUTE-79", categorieId: "route_general", titre: "Refus d'obtempérer", contenu: "Le refus volontaire d'obéir à un ordre d'arrêt constitue un délit routier." },
-  { id: "ROUTE-80", categorieId: "route_general", titre: "Principe general", contenu: "Tout conducteur est tenu d'exercer la conduite avec prudence, diligence et respect de l'État de San Andreas." },
-  { id: "ROUTE-81", categorieId: "route_general", titre: "Principe general", contenu: "Tout véhicule circulant sur une voie publique doit être conforme aux dispositions du présent Code et être maintenu dans un état garantissant la sécurité de ses occupants ainsi que des autres usagers." },
-  { id: "ROUTE-82", categorieId: "route_general", titre: "Obligation de conformité", contenu: "Le propriétaire d'un véhicule est responsable de sa conformité aux exigences légales. Le conducteur demeure responsable des infractions constatées pendant la circulation." },
-  { id: "ROUTE-83", categorieId: "route_general", titre: "Vehicules autorises", contenu: "Seuls les véhicules répondant aux normes de sécurité fixees par la loi peuvent circuler sur les voies publiques." },
-  { id: "ROUTE-84", categorieId: "route_general", titre: "Vehicules interdits", contenu: "Il est interdit de mettre en circulation un véhicule gravement endommagé, déclaré dangereux, interdit par décision administrative ou judiciaire." },
-  { id: "ROUTE-85", categorieId: "route_general", titre: "Entretien", contenu: "Tout propriétaire est tenu d'assurer un entretien régulier de son véhicule. L'absence manifeste d'entretien engage sa responsabilité." },
-  { id: "ROUTE-86", categorieId: "route_general", titre: "Obligation d'immatriculation", contenu: "Tout véhicule motorisé circulant sur la voie publique doit être immatriculé." },
