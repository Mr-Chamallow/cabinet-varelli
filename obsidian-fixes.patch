-  { id: "ROUTE-120", categorieId: "route_general", titre: "Protection", contenu: "Le conducteur doit redoubler de vigilance à proximité des piétons." },
-  { id: "ROUTE-121", categorieId: "route_general", titre: "Personnes vulnerables", contenu: "Une vigilance particulière est exigée envers les enfants, les personnes âgées, les personnes en situation de handicap." },
-  { id: "ROUTE-122", categorieId: "route_general", titre: "Trottoirs", contenu: "Les véhicules doivent laisser libres les trottoirs destinés aux piétons." },
