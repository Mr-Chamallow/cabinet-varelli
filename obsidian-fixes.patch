-  { id: "ROUTE-94", categorieId: "route_general", titre: "Sirenes", contenu: "L'utilisation d'une sirène réservée aux véhicules d'urgence est interdite." },
-  { id: "ROUTE-95", categorieId: "route_general", titre: "Gyrophare", contenu: "Nul ne peut installer ou utiliser un gyrophare réservé aux autorités sans autorisation. Cette infraction sera punie d'une amende de 1 500$.", amende: "1 500$" },
-  { id: "ROUTE-96", categorieId: "route_general", titre: "Vehicules de competition", contenu: "Les véhicules destines exclusivement à la compétition ne peuvent circuler sur la voie publique sans autorisation." },
-  { id: "ROUTE-97", categorieId: "route_general", titre: "Controle technique", contenu: "L'autorité compétente peut soumettre tout véhicule à un contrôle destiné à vérifier sa conformité." },
-  { id: "ROUTE-98", categorieId: "route_general", titre: "Verification", contenu: "Les forces de l'ordre peuvent proceder a une inspection visuelle du vehicule lorsqu'il existe un motif légitime." },
-  { id: "ROUTE-99", categorieId: "route_general", titre: "Immobilisation", contenu: "Un véhicule peut être immobilisé lorsqu'il présente un danger immédiat." },
-  { id: "ROUTE-100", categorieId: "route_general", titre: "Mise en fourriere", contenu: "Le véhicule peut être placé en fourrière lorsque la loi l'autorise." },
-  { id: "ROUTE-101", categorieId: "route_general", titre: "Vehicule vole", contenu: "Tout véhicule déclaré volé peut être saisi et restitué à son propriétaire légitime." },
-  { id: "ROUTE-102", categorieId: "route_general", titre: "Vehicule recherche", contenu: "Les autorités peuvent immobiliser tout véhicule faisant l'objet d'un signalement judiciaire." },
-  { id: "ROUTE-103", categorieId: "route_general", titre: "Refus de controle", contenu: "Le refus de permettre un contrôle légal du véhicule constitue une infraction." },
-  { id: "ROUTE-104", categorieId: "route_general", titre: "Responsabilite du proprietaire", contenu: "Le propriétaire est tenu de veiller à ce que son véhicule demeure conforme aux dispositions du présent Code pendant toute sa durée d'utilisation." },
-  { id: "ROUTE-105", categorieId: "route_general", titre: "Principe general", contenu: "Tout conducteur doit circuler avec prudence, vigilance et courtoisie afin d'assurer la sécurité de l'ensemble des usagers de la route." },
-  { id: "ROUTE-106", categorieId: "route_general", titre: "Maitrise permanente", contenu: "Le conducteur doit conserver en permanence la maîtrise de son véhicule. Il doit être en mesure d'effectuer toute manœuvre nécessaire afin d'éviter un accident." },
-  { id: "ROUTE-107", categorieId: "route_general", titre: "Conduite prudente", contenu: "Le conducteur adapte sa conduite aux conditions météorologiques, à la visibilité, à la circulation, à l'état de la chaussée, aux risques prévisibles." },
-  { id: "ROUTE-108", categorieId: "route_general", titre: "Mise en danger", contenu: "Il est interdit d'adopter un comportement susceptible de mettre en danger une personne ou un bien." },
-  { id: "ROUTE-109", categorieId: "route_general", titre: "Courtoisie", contenu: "Les usagers doivent adopter un comportement respectueux envers les autres usagers. Toute conduite agressive est interdite." },
-  { id: "ROUTE-110", categorieId: "route_general", titre: "Circulation a droite", contenu: "Sauf disposition contraire, les véhicules circulent sur la partie droite de la chaussée." },
-  { id: "ROUTE-111", categorieId: "route_general", titre: "Voies de circulation", contenu: "Le conducteur doit utiliser la voie correspondant à sa direction." },
-  { id: "ROUTE-112", categorieId: "route_general", titre: "Changement de voie", contenu: "Tout changement de voie doit être effectué après vérification de la circulation, sans créer de danger, après utilisation du clignotant." },
-  { id: "ROUTE-113", categorieId: "route_general", titre: "Circulation en sens inverse", contenu: "Il est interdit de circuler à contresens, sauf autorisation des autorites ou circonstances exceptionnelles." },
-  { id: "ROUTE-114", categorieId: "route_general", titre: "Utilisation des accotements", contenu: "Les accotements ne peuvent être utilises pour circuler sauf nécessité absolue ou autorisation." },
