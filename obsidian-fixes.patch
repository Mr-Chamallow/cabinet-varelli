-  { id: "ROUTE-116", categorieId: "route_general", titre: "Bande d'arret d'urgence", contenu: "La bande d'arrêt d'urgence ne peut être utilisée qu'en cas d'urgence, de panne, d'accident, d'injonction des autorités." },
